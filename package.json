{
  "name": "regulatory-activity-graph-gate",
  "version": "0.1.0",
  "description": "Release gate that detects when a software change silently alters approved financial activity topology.",
  "type": "module",
  "scripts": {
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit",
    "build:policy": "tsx scripts/build-policy.ts",
    "generate:baseline": "tsx scripts/generate-baseline.ts",
    "cli": "tsx src/cli/index.ts",
    "evaluate": "tsx src/cli/index.ts evaluate",
    "demo:live": "node dist/src/cli/index.js evaluate --baseline .regulatory/approved-baseline.json --source ./fixtures/case-block"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@open-policy-agent/opa-wasm": "^1.9.0",
    "commander": "^12.1.0",
    "ts-morph": "^22.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
